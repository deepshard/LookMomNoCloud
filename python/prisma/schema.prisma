datasource db {
    provider = "sqlite"
    // url      = "file:/Users/truffle-os/Library/Application Support/truffle-app/truffle.test.db"
    url      = env("DATABASE_URL")
}

generator db {
    provider             = "prisma-client-py"
    interface            = "asyncio"
    recursive_type_depth = 5
}

model RunningModels {
    db_id        String @id @default(cuid())
    id           String
    instance     Int
    name         String
    size         BigInt
    pid          Int
    port         Int
    quantization String
}
