{
  "name": "truffle-app",
  "productName": "truffle-app",
  "version": "0.0.12",
  "description": "My Electron application description",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "build:server": "cd python && pyinstaller server.spec --distpath ../bin/ --clean",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "watch-css": "bunx tailwindcss -i ./src/index.css -o ./src/output.css --watch",
    "python:dev": "uvicorn python.server:app --host 0.0.0.0 --port 8899 --reload",
    "format:py": "black python",
    "format:ts": "eslint . --ext .ts,.tsx --fix",
    "test": "bun test --watch",
    "build:fe": "electron-builder build  --publish always",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "full-build": "electron-forge make && electron-builder build --mac --linux",
    "full-build:publish": "electron-forge make && electron-builder build --mac --linux --publish always"
  },
  "build": {
    "appId": "com.truffle.app",
    "productName": "Truffle",
    "files": [
      ".vite/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "src/assets",
        "to": "assets"
      }
    ],
    "mac": {
      "icon": "src/assets/icons/truffle-logo.png",
      "target": [
        "dmg",
        "zip"
      ],
      "notarize": {
        "teamId": "4SDV2299VV"
      }
    },
    "dmg": {
      "title": "Look Mom No Cloud™",
      "background": "src/assets/icons/dmg-background.png",
      "window": {
        "width": 537,
        "height": 442
      }
    },
    "linux": {
      "icon": "src/assets/icons/truffle-logo.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": {
      "provider": "s3",
      "bucket": "truffle-fe"
    }
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^1.5.0",
    "@electron-forge/cli": "^7.4.0",
    "@electron-forge/maker-deb": "^7.4.0",
    "@electron-forge/maker-rpm": "^7.4.0",
    "@electron-forge/maker-squirrel": "^7.4.0",
    "@electron-forge/maker-zip": "^7.4.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.4.0",
    "@electron-forge/plugin-fuses": "^7.4.0",
    "@electron-forge/plugin-vite": "^7.4.0",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.3.0",
    "@happy-dom/global-registrator": "^14.12.0",
    "@storybook/addon-essentials": "^8.1.10",
    "@storybook/addon-interactions": "^8.1.10",
    "@storybook/addon-links": "^8.1.10",
    "@storybook/addon-onboarding": "^8.1.10",
    "@storybook/addon-styling": "^1.3.7",
    "@storybook/blocks": "^8.1.10",
    "@storybook/react": "^8.1.10",
    "@storybook/react-vite": "^8.1.10",
    "@storybook/test": "^8.1.10",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "autoprefixer": "^10.4.19",
    "electron": "30.0.3",
    "electron-builder": "^24.13.3",
    "eslint": "8.x",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-storybook": "^0.8.0",
    "globals": "^15.3.0",
    "postcss": "^8.4.38",
    "storybook": "^8.1.10",
    "tailwindcss": "^3.4.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2",
    "typescript-eslint": "^7.11.0",
    "vite": "^5.2.11"
  },
  "keywords": [],
  "author": {
    "name": "rk",
    "email": "this.rajkhare@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.1",
    "@tanstack/react-query": "^5.37.1",
    "@testing-library/react": "^15.0.7",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.4",
    "@types/pidusage": "^2.0.5",
    "@types/react-transition-group": "^4.4.10",
    "@types/uuid": "^9.0.8",
    "antd": "^5.17.2",
    "axios": "^1.6.8",
    "electron-settings": "^4.0.4",
    "electron-squirrel-startup": "^1.0.0",
    "electron-updater": "^6.2.1",
    "extract-zip": "^2.0.1",
    "framer-motion": "^11.2.9",
    "glob": "^10.3.15",
    "lodash": "^4.17.21",
    "mixpanel-browser": "^2.53.0",
    "msw": "^2.3.0",
    "node-gyp": "^10.1.0",
    "react": "^18.3.1",
    "react-circular-progressbar": "^2.1.0",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-intersection-observer": "^9.10.3",
    "react-lazy-load-image-component": "^1.6.2",
    "react-loading-skeleton": "^3.4.0",
    "react-router-dom": "^6.23.1",
    "react-spinners": "^0.13.8",
    "react-transition-group": "^4.4.5",
    "systeminformation": "^5.22.11",
    "uuid": "^9.0.1",
    "vaul": "^0.9.1",
    "winston": "^3.13.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  }
}