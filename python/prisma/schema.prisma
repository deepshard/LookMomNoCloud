datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

generator db {
    provider             = "prisma-client-py"
    interface            = "asyncio"
    recursive_type_depth = 5
}

model RunningModels {
    id           String @id
    instance     Int
    name         String
    size         Int
    pid          Int
    port         Int
    quantization String
}
